# Copy this file to .env or export the variables in your shell.
# Never commit real API keys.

MODELVERSE_API_KEY=your_api_key_here
MODELVERSE_BASE_URL=https://api.modelverse.cn/v1/
MODELVERSE_MODEL=gemini-2.5-pro

# Optional defaults for agent/gemini_batchThreadPoolExecutor.py
GEMINI_INPUT_FOLDER=agent/input_jsons
GEMINI_OUTPUT_FOLDER=agent/output_results
GEMINI_MAX_WORKERS=10
